# Sanity project (see manage.sanity.io)
SANITY_PROJECT_ID=q0vyljg1
SANITY_DATASET=production

# Project-level token with write access (Editor role) - used for seeding
# and for the agent to write claim/quoteEvidence/redTeamRun/trustMetricSnapshot back.
SANITY_API_TOKEN=

# Sanity Context MCP - created in the Sanity Dashboard Context app,
# pointed at this project/dataset in GROQ mode.
SANITY_CONTEXT_MCP_URL=
# Organization-level token with "Context Viewer" permission (not a project token).
SANITY_ORGANIZATION_TOKEN=

# Groq API key (console.groq.com) - powers quote extraction + answer generation.
GROQ_API_KEY=
